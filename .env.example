# Fenêtre glissante de collecte active (jours). Défaut : 90.
# Augmenter pour un premier import historique, réduire pour les runs quotidiens.
SCRAPER_WINDOW_DAYS=90

# Nombre de tenders analysés par batch LLM auto post-collecte. Défaut : 10.
LLM_BATCH_SIZE=10

# Fenêtre de collecte DECP en jours (indépendante de SCRAPER_WINDOW_DAYS). Défaut : 30.
DECP_WINDOW_DAYS=30
